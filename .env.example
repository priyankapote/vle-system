# Copy this file to .env and change the values before running in production.

PORT=4000

# Secret used to sign login tokens. Change this to a long random string.
JWT_SECRET=change-this-to-a-long-random-secret

# Invite codes required to sign up as internal roles.
# Share these ONLY with people who should actually get that access.
# Customer signup does NOT need a code (customers are the public-facing role).
ADMIN_INVITE_CODE=change-this-admin-code
STAFF_INVITE_CODE=change-this-staff-code
DELIVERY_INVITE_CODE=change-this-delivery-code

# --- Optional: demo data (useful on free hosting where data resets when the server sleeps/redeploys) ---
# When SEED_DEMO=true and the database is empty, demo accounts and sample cylinders are created.
# Turn it off (or delete these two lines) for real use.
# SEED_DEMO=true
# DEMO_PASSWORD=choose-a-strong-password
